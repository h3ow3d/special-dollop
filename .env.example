# GitHub OAuth Application credentials
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: http://localhost:8080/auth/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URL=http://localhost:8080/auth/callback

# Security secrets – replace with cryptographically random 32-byte values
# Example: openssl rand -hex 32
CSRF_AUTH_KEY=replace-with-32-byte-csrf-secret-value
SESSION_SECRET=replace-with-32-byte-session-secret!!

# Set to "true" in production (HTTPS). Keep "false" for local HTTP development.
SECURE_COOKIES=false

# Set to "true" only for local development when you want the authentication
# information panel visible in the UI. Leave "false" in production.
DEV_MODE=false

# PostgreSQL connection string – REQUIRED.
# This is set automatically by Docker Compose using the postgres service.
# For local development outside Compose, point to your local PostgreSQL instance.
# Example format: ******HOST:5432/DBNAME?sslmode=disable
DATABASE_URL=

# PostgreSQL password used by Docker Compose (overrides the cdscam_dev default).
# Example: openssl rand -hex 16
POSTGRES_PASSWORD=cdscam_dev

# OCI registry credentials used as a fallback when publishing the attestation.
# By default the logged-in user's GitHub OAuth token (which includes write:packages
# scope) is used for GHCR pushes, so these values are optional.
# Set them only if you need a shared service-account identity to publish under
# instead of the individual assessor's credentials.
OCI_USERNAME=
OCI_PASSWORD=

# Set to "true" only for local, non-TLS registries such as a development registry on localhost.
OCI_PLAIN_HTTP=false
