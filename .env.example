# GitHub OAuth Application credentials
# Create an OAuth App at https://github.com/settings/developers
# Set the callback URL to: http://localhost:8080/auth/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URL=http://localhost:8080/auth/callback

# Security secrets – replace with cryptographically random 32-byte values
# Example: openssl rand -hex 32
CSRF_AUTH_KEY=replace-with-32-byte-csrf-secret-value
SESSION_SECRET=replace-with-32-byte-session-secret!!

# Set to "true" in production (HTTPS). Keep "false" for local HTTP development.
SECURE_COOKIES=false
